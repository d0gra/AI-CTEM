# Copy to .env. Never commit the real file. All application settings use the CTEM_ prefix.

# --- Required secrets ---------------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CTEM_SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; the first key encrypts, all keys decrypt (see docs/security.md, key rotation).
CTEM_ENCRYPTION_KEYS=
# Database passwords (Docker Compose creates the roles from these)
POSTGRES_PASSWORD=
CTEM_OWNER_DB_PASSWORD=
CTEM_APP_DB_PASSWORD=

# --- Runtime ------------------------------------------------------------------------------
CTEM_ENV=production                     # development | test | production
CTEM_PUBLIC_BASE_URL=http://localhost:3000
CTEM_COOKIE_SECURE=true                 # set false only for plain-HTTP local use
CTEM_ALLOW_REGISTRATION=true            # set false after creating your organization
CTEM_REQUIRE_EMAIL_VERIFICATION=false   # block everything but account pages until the email is verified (needs SMTP)
CTEM_TRUSTED_PROXIES=127.0.0.1/32,::1/128   # reverse proxies allowed to report the client address (X-Forwarded-For)
CTEM_WEB_PORT=3000

# Outside Docker Compose, set the connection strings directly:
# CTEM_DATABASE_URL=postgresql+psycopg://ctem_app:<password>@127.0.0.1:5432/ctem
# CTEM_MIGRATION_DATABASE_URL=postgresql+psycopg://ctem_owner:<password>@127.0.0.1:5432/ctem
# CTEM_REDIS_URL=redis://127.0.0.1:6379/0   # optional in single-process development

# --- Assessment network policy ------------------------------------------------------------
CTEM_ALLOW_PRIVATE_TARGETS=false        # allow assessing private/loopback addresses that are also in scope
CTEM_REPO_SCAN_ROOT=                    # directory on workers under which repositories may be analysed
CTEM_SCANNER_TIMEOUT_SECONDS=900

# --- Sessions and rate limits -------------------------------------------------------------
CTEM_SESSION_TTL_MINUTES=720
CTEM_SESSION_IDLE_MINUTES=60
CTEM_RATE_LIMIT_AUTH=10
CTEM_RATE_LIMIT_API=600

# --- Storage (evidence, reports) ----------------------------------------------------------
CTEM_STORAGE_BACKEND=local              # local | s3
CTEM_STORAGE_LOCAL_PATH=./var/storage
CTEM_S3_BUCKET=
CTEM_S3_ENDPOINT_URL=
CTEM_S3_REGION=us-east-1
CTEM_MAX_UPLOAD_BYTES=26214400

# --- Email (verification, password reset, notification rules) -----------------------------
CTEM_SMTP_HOST=
CTEM_SMTP_PORT=587
CTEM_SMTP_USERNAME=
CTEM_SMTP_PASSWORD=
CTEM_SMTP_FROM=ctem@example.com

# --- Threat intelligence ------------------------------------------------------------------
CTEM_NVD_API_KEY=                       # optional; raises the NVD rate limit

# --- Workers ------------------------------------------------------------------------------
CTEM_WORKER_CONCURRENCY=4
CTEM_JOB_MAX_ATTEMPTS=3
CTEM_MAX_RUNNING_JOBS_PER_ORG=4
CTEM_ASSET_STALE_DAYS=30                # assets unseen by discovery this long are marked stale
CTEM_WORKER_METRICS_PORT=9108

# --- Observability ------------------------------------------------------------------------
CTEM_LOG_LEVEL=INFO
CTEM_LOG_JSON=true
CTEM_OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://otel-collector:4318

# --- Claude (AI analysis) ----------------------------------------------------------------
# Organizations connect Claude under Administration -> AI analysis with a Claude Console API key.
# Set true to also let them use THIS server's Claude credentials (ANTHROPIC_API_KEY, an `ant auth login`
# profile, or workload identity federation). Usage is then billed to the operator's Console organization.
CTEM_ALLOW_SERVER_CLAUDE_CREDENTIALS=false

# --- Frontend build -----------------------------------------------------------------------
CTEM_BACKEND_URL=http://127.0.0.1:8000  # API origin as seen by the Next.js server (build-time)
# true only when a reverse proxy in front of the web server appends the real client address to X-Forwarded-For.
# Otherwise the web server strips the header so clients cannot choose the address used for rate limits and audit.
CTEM_UPSTREAM_PROXY=false
