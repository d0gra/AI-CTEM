# syntax=docker/dockerfile:1.7
# All-in-one public demo image: PostgreSQL, API, worker and web in one container, for a single-service
# host such as Render. Data is not persistent: each restart starts a clean demo with one account per role.
# Not for production use; see docker-compose.yml and infrastructure/kubernetes for real deployments.
#
#   docker build -f Dockerfile.demo -t ctem-demo .
#   docker run --rm -p 10000:10000 ctem-demo        # then open http://localhost:10000

FROM node:22-bookworm-slim AS web
WORKDIR /app
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
# The API runs in the same container; the web server proxies /api/* to it over loopback.
ENV CTEM_BACKEND_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM postgres:17-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_PREFERENCE=only-managed \
    NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 LANG=C.UTF-8 LC_ALL=C.UTF-8 PORT=10000
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
# Fail the build here, not at start-up, if Node or gosu cannot run in this base image.
RUN node --version && gosu nobody true

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv python install 3.12 && uv sync --frozen --no-dev --no-install-project --python 3.12 && rm -rf /root/.cache
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
COPY backend/app ./app

COPY --from=web /app/.next/standalone /app/web
COPY --from=web /app/.next/static /app/web/.next/static
COPY --from=web /app/public /app/web/public
COPY infrastructure/demo/entrypoint.sh /usr/local/bin/ctem-demo

RUN useradd --system --uid 10001 --home-dir /app ctem \
 && mkdir -p /app/var/storage /app/var/repos \
 && chown -R ctem /app/var \
 && chmod 0755 /usr/local/bin/ctem-demo

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD ["/app/backend/.venv/bin/python", "-c", "import os,sys,urllib.request; sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"10000\")}/api/v1/demo', timeout=4).status == 200 else 1)"]
ENTRYPOINT ["ctem-demo"]
